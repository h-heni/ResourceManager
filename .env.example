# ============================================
# MoovmaCrea Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to source control!
# ============================================

# Database (Supabase-hosted PostgreSQL)
DB_CONNECTION_STRING=Host=your-project.supabase.co;Database=postgres;Username=postgres;Password=your-password;SSL Mode=Require;Trust Server Certificate=true

# JWT Authentication
JWT_KEY=YourSecretKeyMustBeAtLeast32CharactersLong!
JWT_ISSUER=MyAwesomeApp
JWT_AUDIENCE=MyAwesomeUsers
JWT_EXPIRATION=100

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# Google Integration (OAuth + Drive/Sheets)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token

# Auth0 (OpenID Connect)
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
AUTH0_AUDIENCE=https://your-api-identifier

# Frontend (Vite build-time variables)
VITE_API_URL=http://localhost:8080
VITE_GOOGLE_CLIENT_ID=your-google-client-id
