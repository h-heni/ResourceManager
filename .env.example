# ═══════════════════════════════════════════════════════════════
# ResourceManager — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to source control.
# ═══════════════════════════════════════════════════════════════

# ── Database ──
POSTGRES_DB=resourcemanager
POSTGRES_USER=rmuser
POSTGRES_PASSWORD=YOUR_STRONG_DB_PASSWORD_HERE

# ── JWT Secret Key ──
# MUST be at least 32 characters. Use a cryptographically random string.
# Generate one with: openssl rand -base64 48
JWT_KEY=REPLACE_WITH_A_SECURE_RANDOM_KEY_AT_LEAST_32_CHARS_LONG
JWT_ISSUER=ResourceManager
JWT_AUDIENCE=ResourceManager-Users
JWT_EXPIRATION=15

# ── Google Integration (Gmail API — for sending invoice emails) ──
# Leave empty if not using Gmail integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── Supabase (File Storage - Optional) ──
# Leave empty if not using Supabase
SUPABASE_URL=
SUPABASE_KEY=

# ── Docker Images (GHCR - GitHub Container Registry) ──
# Specify custom image names/tags if needed
API_IMAGE=resourcemanager-api:latest
WEB_IMAGE=resourcemanager-web:latest

# ── Network Ports ──
# Ports exposed on the host machine
WEB_PORT=80
# WEB_PORT_SSL=443  # Uncomment for HTTPS
API_PORT=5000

# ── GHCR Authentication (for VPS to pull private images) ──
# On VPS, login with: echo $GHCR_TOKEN | docker login ghcr.io -u h-heni --password-stdin
# Create token at: https://github.com/settings/tokens
# Required scope: read:packages
# Note: For production deployment with CI/CD, update API_IMAGE and WEB_IMAGE above:
#   API_IMAGE=ghcr.io/h-heni/resourcemanager-api:latest
#   WEB_IMAGE=ghcr.io/h-heni/resourcemanager-web:latest
# GHCR_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── CORS Configuration ──
# Add your production domain(s) here
# Examples:
#   - http://85.214.180.48 (IP address)
#   - https://yourdomain.com (with HTTPS)
#   - https://www.yourdomain.com (with www subdomain)
CORS_ORIGIN_1=http://localhost
CORS_ORIGIN_2=http://localhost:80

# ── Production Deployment Notes ──
# 1. Change all passwords before deploying
# 2. Update CORS origins to match your domain
# 3. Consider enabling HTTPS for production
# 4. Review security settings in docker-compose.prod.yml
# 5. Set up regular database backups
# 6. Monitor resource usage: docker stats
# 7. For CI/CD deployment, see CI-CD.md and SECRETS.md
