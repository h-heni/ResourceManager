# ═══════════════════════════════════════════════════════════════
# ResourceManager - Environment Variables Template
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ─── Database Connection ───
DATABASE_URL=Host=localhost;Database=resourcemanager;Username=postgres;Password=your_password

# ─── JWT Configuration ───
JWT_KEY=your-super-secret-jwt-key-at-least-64-characters-long-for-security

# ─── Redis Cache (optional) ───
REDIS_CONNECTION_STRING=localhost:6379

# ─── Supabase Storage (optional) ───
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# ═══════════════════════════════════════════════════════════════
# EMAIL CONFIGURATION (SMTP via MailKit)
# Uses your domain's local SMTP server - NO third-party dependencies
# ═══════════════════════════════════════════════════════════════

# SMTP Server Settings (your VPS mail server)
EMAIL_SMTP_HOST=mail.rscmanager.com
EMAIL_SMTP_PORT=587
EMAIL_USE_TLS=true

# SMTP Authentication
EMAIL_SMTP_USER=contact@rscmanager.com
EMAIL_SMTP_PASSWORD=your-smtp-password

# Sender Information
EMAIL_FROM_ADDRESS=contact@rscmanager.com
EMAIL_FROM_NAME=Resource Manager
EMAIL_REPLY_TO=contact@rscmanager.com

# ═══════════════════════════════════════════════════════════════
# APPLICATION SETTINGS
# ═══════════════════════════════════════════════════════════════

# Application Base URL (for password reset links, etc.)
APP_BASE_URL=https://rscmanager.com

# CORS Allowed Origins (comma-separated)
# Example: https://rscmanager.com,https://www.rscmanager.com
CORS_ORIGINS=https://rscmanager.com

# ═══════════════════════════════════════════════════════════════
# WHATSAPP BUSINESS API (Meta)
# Required to enable WhatsApp invoice sending and Embedded Signup.
# Create a Meta Business App at https://developers.facebook.com,
# add the WhatsApp product, and copy the values below.
# ═══════════════════════════════════════════════════════════════

# Meta App credentials (from App Dashboard → Settings → Basic)
WHATSAPP__METAAPPID=your-meta-app-id
WHATSAPP__METAAPPSECRET=your-meta-app-secret

# Fallback / test credentials (used before Embedded Signup or for a shared test number)
WHATSAPP__PHONENUMBERID=SET_VIA_ENVIRONMENT
WHATSAPP__ACCESSTOKEN=SET_VIA_ENVIRONMENT
WHATSAPP__BUSINESSACCOUNTID=SET_VIA_ENVIRONMENT

# Webhook verify token — must match the value you enter in the Meta App webhook config
WHATSAPP__WEBHOOKVERIFYTOKEN=choose-a-random-secret-string

# WhatsApp OTP Login — template name must match the approved Authentication template in Meta Business Manager
# Create it at: Meta Business Suite → WhatsApp Manager → Message Templates (category: Authentication)
WHATSAPP__OTPTEMPLATENAME=login_otp
WHATSAPP__OTPTEMPLATELANGUAGE=en

# ═══════════════════════════════════════════════════════════════
# PRODUCTION DEPLOYMENT
# ═══════════════════════════════════════════════════════════════

# Set to "Production" in production environment
ASPNETCORE_ENVIRONMENT=Development

# Logging level
LOG_LEVEL=Information
