# ═══════════════════════════════════════════════════════════════
# ResourceManager — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to source control.
# ═══════════════════════════════════════════════════════════════

# ── Database ──
POSTGRES_DB=resourcemanager
POSTGRES_USER=rmuser
POSTGRES_PASSWORD=YOUR_STRONG_DB_PASSWORD_HERE

# ── JWT Secret Key ──
# MUST be at least 32 characters. Use a cryptographically random string.
# Generate one with: openssl rand -base64 48
JWT_KEY=REPLACE_WITH_A_SECURE_RANDOM_KEY_AT_LEAST_32_CHARS_LONG
JWT_ISSUER=ResourceManager
JWT_AUDIENCE=ResourceManager-Users
JWT_EXPIRATION=15

# ── Google Integration (Gmail API — for sending invoice emails) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── Frontend ──
WEB_PORT=80

# ── Docker Images (GHCR - GitHub Container Registry) ──
# For local development (use local builds):
# API_IMAGE=resourcemanager-api:latest
# WEB_IMAGE=resourcemanager-web:latest
#
# For VPS production deployment (use GHCR images):
# These will be automatically updated by CI/CD pipeline
API_IMAGE=ghcr.io/h-heni/resourcemanager-api:latest
WEB_IMAGE=ghcr.io/h-heni/resourcemanager-web:latest

# ── GHCR Authentication (for VPS to pull private images) ──
# On VPS, login with: echo $GHCR_TOKEN | docker login ghcr.io -u h-heni --password-stdin
# Create token at: https://github.com/settings/tokens
# Required scope: read:packages
# GHCR_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── CORS (comma-separated allowed origins for production) ──
# Cors__AllowedOrigins__0=https://yourdomain.com
# Cors__AllowedOrigins__1=https://www.yourdomain.com
