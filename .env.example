# ═══════════════════════════════════════════════════════════════
# ResourceManager — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to source control.
# ═══════════════════════════════════════════════════════════════

# ── Database ──
POSTGRES_DB=resourcemanager
POSTGRES_USER=rmuser
POSTGRES_PASSWORD=YOUR_STRONG_DB_PASSWORD_HERE

# ── JWT Secret Key ──
# MUST be at least 32 characters. Use a cryptographically random string.
# Generate one with: openssl rand -base64 48
JWT_KEY=REPLACE_WITH_A_SECURE_RANDOM_KEY_AT_LEAST_32_CHARS_LONG
JWT_ISSUER=ResourceManager
JWT_AUDIENCE=ResourceManager-Users
JWT_EXPIRATION=15

# ── Google Integration (Gmail API — for sending invoice emails) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── Frontend ──
WEB_PORT=80
API_IMAGE=resourcemanager-api:latest
WEB_IMAGE=resourcemanager-web:latest

# ── Docker Hub (for production deployments) ──
# These will be automatically updated by CI/CD
# Format: dockerhub-username/resourcemanager-api:latest
# API_IMAGE=your-dockerhub-username/resourcemanager-api:latest
# WEB_IMAGE=your-dockerhub-username/resourcemanager-web:latest

# ── CORS (comma-separated allowed origins for production) ──
# Cors__AllowedOrigins__0=https://yourdomain.com
# Cors__AllowedOrigins__1=https://www.yourdomain.com
