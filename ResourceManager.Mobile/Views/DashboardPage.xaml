<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ResourceManager.Mobile.Views.DashboardPage"
             Title="Dashboard"
             BackgroundColor="#eef2f5">
    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">
            <!-- Summary Card -->
            <Frame CornerRadius="15" HasShadow="True" BorderColor="Transparent" BackgroundColor="White">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Total Revenue" TextColor="Gray" FontSize="14"/>
                    <Label x:Name="RevenueLabel" Text="Loading..." TextColor="#2d3748" FontSize="28" FontAttributes="Bold"/>
                </VerticalStackLayout>
            </Frame>

            <Label Text="Recent Invoices" FontSize="18" FontAttributes="Bold" TextColor="#2d3748" Margin="0,10,0,0"/>

            <CollectionView x:Name="InvoicesList">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,5" CornerRadius="10" Padding="15" BorderColor="Transparent">
                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="{Binding ClientName}" FontAttributes="Bold" TextColor="#2d3748"/>
                                    <Label Text="{Binding Number}" FontSize="12" TextColor="Gray"/>
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="{Binding Amount}" FontAttributes="Bold" TextColor="#667eea"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
