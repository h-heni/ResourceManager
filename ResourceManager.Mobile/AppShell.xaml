<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ResourceManager.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ResourceManager.Mobile"
    xmlns:views="clr-namespace:ResourceManager.Mobile.Views"
    Title="ResourceManager"
    Shell.TabBarBackgroundColor="#764ba2"
    Shell.TabBarTitleColor="White"
    Shell.TabBarUnselectedColor="#C4A8E0">

    <TabBar>
        <Tab Title="Dashboard" Icon="dotnet_bot.png">
            <ShellContent ContentTemplate="{DataTemplate views:DashboardPage}" />
        </Tab>
        <Tab Title="Scan" Icon="dotnet_bot.png">
            <ShellContent ContentTemplate="{DataTemplate views:CaptureInvoicePage}" />
        </Tab>
        <Tab Title="Invoices" Icon="dotnet_bot.png">
            <ShellContent ContentTemplate="{DataTemplate views:DashboardPage}" />
        </Tab>
    </TabBar>

</Shell>
