# ============================================
# Docker Ignore - Frontend (React + Vite)
# ============================================

# Dependencies
node_modules/

# Build output (we build fresh in container)
dist/
build/

# Git
.git
.gitignore

# IDE
.vscode/
.idea/
*.swp
*.swo

# Environment files (secrets injected at build time)
.env
.env.*
*.env

# Test files
coverage/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
__tests__/

# Documentation
*.md
!README.md

# Docker files
Dockerfile*
.dockerignore

# Misc
*.log
*.tmp
.DS_Store
Thumbs.db

# TypeScript cache
*.tsbuildinfo
