@page
@model AttachFournisseurPdfModel
@{
    ViewData["Title"] = "Attacher Facture Fournisseur";
}

<div class="container py-5">

    <!-- Fancy Header -->
    <div class="text-center mb-5">
        <h1>Factures Fournisseurs</h1>
        <div style="height: 4px; width: 60px; background: #764ba2; margin: 10px auto; border-radius: 2px;"></div>
        <p class="text-muted">Uploadez le PDF du fournisseur et liez-le à une facture client (Optionnel)</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success fancy-card border-start border-success border-5 mb-4 d-flex align-items-center">
            <i class="bi bi-check-circle-fill text-success fs-4 me-3"></i>
            <div>@TempData["SuccessMessage"]</div>
        </div>
    }
    @if (TempData["FailedMessage"] != null)
    {
        <div class="alert alert-danger fancy-card border-start border-danger border-5 mb-4 d-flex align-items-center">
            <i class="bi bi-x-circle-fill text-danger fs-4 me-3"></i>
            <div>@TempData["FailedMessage"]</div>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <form method="post" asp-page-handler="Upload" enctype="multipart/form-data" id="uploadForm">

                <!-- MAIN CARD -->
                <div class="fancy-card p-5">

                    <!-- SECTION 1: UPLOAD -->
                    <div class="mb-5">
                        <h5 class="text-primary fw-bold text-uppercase small border-bottom border-dark pb-2 mb-4">
                            <i class="bi bi-cloud-upload-fill me-2"></i>1. Informations & Fichier
                        </h5>

                        <div class="row g-4">
                            <!-- Supplier Selection -->
                            <div class="col-md-6">
                                <label class="form-label text-muted small fw-bold text-uppercase">Fournisseur</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-0"><i class="bi bi-shop text-primary fs-4"></i></span>
                                    <select asp-for="SelectedFournisseurName" asp-items="Model.Fournisseurs" class="form-select form-select-lg bg-light border border-dark fw-bold text-dark" required>
                                        <option value="">-- Sélectionner --</option>
                                    </select>
                                </div>
                            </div>

                            <!-- File Upload -->
                            <div class="col-md-6">
                                <label class="form-label text-muted small fw-bold text-uppercase">Fichier PDF</label>
                                <input type="file" name="PdfUpload" class="form-control form-control-lg bg-light border border-dark" accept="application/pdf" required />
                                <div class="form-text small"><i class="bi bi-file-earmark-pdf"></i> Format .pdf uniquement</div>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 2: LINKING (FILTERS) -->
                    <div class="bg-light p-4 rounded-4 border border-dark mb-4">
                        <h5 class="text-secondary fw-bold text-uppercase small mb-3">
                            <i class="bi bi-link-45deg me-2"></i>2. Liaison Optionnelle (Filtres)
                        </h5>

                        <div class="row g-3">
                            <!-- Filter 1: Client -->
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Client</label>
                                <select id="clientFilter" asp-for="SelectedClientName" class="form-select fancy-input border-dark filter-input">
                                    <option value="">-- Tous les clients --</option>
                                    @foreach (var name in Model.ClientNameList)
                                    {
                                        <option value="@name">@name</option>
                                    }
                                </select>
                            </div>

                            <!-- Filter 2: Dates -->
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Depuis le</label>
                                <input type="date" id="dateStart" class="form-control fancy-input border-dark filter-input" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Jusqu'au</label>
                                <input type="date" id="dateEnd" class="form-control fancy-input border-dark filter-input" />
                            </div>
                        </div>

                        <!-- AJAX LOADING INDICATOR -->
                        <div id="loadingSpinner" class="text-center my-4 d-none">
                            <div class="spinner-border text-primary" role="status"></div>
                            <p class="small text-muted mt-2">Recherche des factures...</p>
                        </div>

                        <!-- AJAX RESULTS CONTAINER -->
                        <div id="invoiceResults" class="mt-4">
                            <div class="text-center text-muted border border-dashed p-4 rounded-3">
                                <i class="bi bi-search fs-3 d-block mb-2 opacity-50"></i>
                                <span class="fst-italic">Sélectionnez un client et une plage de dates pour voir les factures internes à lier.</span>
                            </div>
                        </div>
                    </div>

                    <!-- SUBMIT BUTTON -->
                    <div class="text-end">
                        <button type="submit" id="btnSubmit" class="btn btn-gradient btn-lg rounded-pill px-5 shadow border border-dark">
                            <i class="bi bi-check-lg me-2"></i> Enregistrer tout
                        </button>
                    </div>

                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // 1. Smart Submit (Prevents double clicks)
        document.getElementById("uploadForm").addEventListener("submit", function() {
            var btn = document.getElementById("btnSubmit");
            // Simple validation check (browser handles 'required')
            if (this.checkValidity()) {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Envoi en cours...';
            }
        });

        // 2. AJAX Filtering Logic
        document.querySelectorAll('.filter-input').forEach(element => {
            element.addEventListener('change', function() {
                const client = document.getElementById('clientFilter').value;
                const start = document.getElementById('dateStart').value;
                const end = document.getElementById('dateEnd').value;

                const resultsContainer = document.getElementById('invoiceResults');
                const spinner = document.getElementById('loadingSpinner');

                // Only trigger if all three filters are set
                if (client && start && end) {

                    // Show Spinner, Hide Results
                    spinner.classList.remove('d-none');
                    resultsContainer.style.opacity = '0.5';

                    const url = `?handler=FilterInvoices&clientName=${encodeURIComponent(client)}&start=${start}&end=${end}`;

                    fetch(url)
                        .then(response => response.text())
                        .then(html => {
                            // Update content
                            resultsContainer.innerHTML = html;

                            // Hide Spinner, Show Results
                            spinner.classList.add('d-none');
                            resultsContainer.style.opacity = '1';
                        })
                        .catch(err => {
                            console.error('Erreur de filtrage:', err);
                            spinner.classList.add('d-none');
                            resultsContainer.innerHTML = '<p class="text-danger text-center">Erreur lors du chargement.</p>';
                        });
                }
            });
        });
    </script>
}