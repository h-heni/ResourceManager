@page
@model CreateInvoiceModel
@{
    ViewData["Title"] = "Creation de Facture";
}

<div class="container py-5">

    <!-- Fancy Header -->
    <div class="text-center mb-5">
        <h1>Nouvelle Facture</h1>
        <div style="height: 4px; width: 60px; background: #764ba2; margin: 10px auto; border-radius: 2px;"></div>
        <p class="text-muted">Générez une facture client ou traitez les bons de livraison</p>
    </div>


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success fancy-card border-start border-success border-5 mb-4 d-flex align-items-center">
            <i class="bi bi-check-circle-fill text-success fs-4 me-3"></i>
            <div>@TempData["SuccessMessage"]</div>
        </div>
    }
    <form method="post" id="invoiceForm">

        <!-- MAIN CARD -->
        <div class="fancy-card p-5 mb-5">

            <!-- Client Selection -->
            <div class="mb-5">
                <div class="row g-4 mb-5 border-bottom border-dark pb-4">

                    <!-- Left: Invoice Number (Smart Input) -->
                    <div class="col-md-6">
                        <div class="d-flex justify-content-between align-items-end mb-1">
                            <label class="form-label text-uppercase text-muted fw-bold small m-0">N° Facture</label>
                            <!-- UX Feature: The "Last Used" Badge -->
                            <span class="badge bg-light text-secondary border border-secondary" title="Dernier numéro utilisé">
                                <i class="bi bi-clock-history me-1"></i>Dernier: @Model.LastInvoiceNumber
                            </span>
                        </div>

                        <div class="input-group">
                            <span class="input-group-text bg-white border-dark text-primary"><i class="bi bi-hash"></i></span>
                            <!-- The input is pre-filled with the Suggested Number -->
                            <input asp-for="InvoiceNumber" class="form-control form-control-lg bg-light border-dark fw-bold text-primary fs-5" placeholder="@Model.InvoiceExample" />
                        </div>
                        <div class="form-text text-success small fw-bold">
                            <i class="bi bi-stars me-1"></i>Veuillez indiquer le numéro de facture suivant...
                        </div>
                        <span asp-validation-for="InvoiceNumber" class="text-danger small"></span>
                    </div>

                </div>
                <label class="form-label text-uppercase text-muted fw-bold small ms-1">Devis</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-0"><i class="bi bi-person-badge-fill text-primary fs-4"></i></span>
                    <!-- Style: bg-light + border-dark -->
                    <select asp-for="SelectedDevisNumber" asp-items="Model.DevisNumber" class="form-select form-select-lg bg-light border border-dark fw-bold text-dark">
                        <option value="">-- Sélectionner un devis--</option>
                    </select>
                </div>
                <!-- Optional: Add validation span if you have it in your model -->
            </div>

            <!-- Items Table -->
            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-end mb-3 border-bottom pb-2">
                    <label class="form-label text-uppercase text-muted fw-bold small m-0">Articles de la facture</label>
                </div>

                <div class="table-responsive">
                    <table class="table table-borderless align-middle" id="itemsTable">
                        <thead class="text-secondary small text-uppercase">
                            <tr>
                                <th style="width: 40%;" class="pb-3">Description</th>
                                <th style="width: 15%;" class="pb-3">Qté</th>
                                <th style="width: 20%; text-align:center;" class="pb-3">TVA (19%)</th>
                                <th style="width: 20%;" class="pb-3">Prix</th>
                                <th style="width: 5%;" class="pb-3"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Items.Count; i++)
                            {
                                <tr>
                                    <td class="p-2">
                                        <input name="Items[@i].Description" value="@Model.Items[i].Description" class="form-control bg-light border border-dark" placeholder="Description..." required />
                                    </td>
                                    <td class="p-2">
                                        <input name="Items[@i].Quantity" value="@Model.Items[i].Quantity" type="number" class="form-control bg-light border border-dark" required />
                                    </td>
                                    <td class="p-2 text-center">
                                        <!-- Fancy Button Group instead of Radio Circles -->
                                        <div class="btn-group btn-group-sm" role="group">
                                            <input type="radio" class="btn-check" name="Items[@i].Tva" value="true" id="tvayes_@i" @(Model.Items[i].Tva ? "checked" : "") required>
                                            <label class="btn btn-outline-primary border-dark" for="tvayes_@i">Oui</label>

                                            <input type="radio" class="btn-check" name="Items[@i].Tva" value="false" id="tvano_@i" @(!Model.Items[i].Tva ? "checked" : "")>
                                            <label class="btn btn-outline-secondary border-dark" for="tvano_@i">Non</label>
                                        </div>
                                    </td>
                                    <td class="p-2">
                                        <div class="input-group">
                                            <input name="Items[@i].Price" value="@Model.Items[i].Price" type="number" step="0.001" class="form-control bg-light border border-dark" placeholder="0.000" required />
                                            <span class="input-group-text bg-light border border-dark border-start-0 text-muted">DT</span>
                                        </div>
                                    </td>
                                    <td class="p-2 text-end">
                                        <button type="button" class="btn btn-light text-danger border border-dark rounded-circle shadow-sm remove-row">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="text-center mt-3">
                    <button type="button" class="btn btn-light text-primary border-dark border rounded-pill px-4 shadow-sm fw-bold" onclick="addItemRow()">
                        <i class="bi bi-plus-lg me-1"></i> Ajouter un article
                    </button>
                </div>
            </div>

            <!-- Footer Action -->
            <div class="pt-4 border-top border-dark mt-4 text-end">
                <button type="submit" id="btnSubmit" class="btn btn-gradient rounded-pill px-5 py-3 shadow border border-dark fs-5">
                    Générer, Sauvegarder & Upload
                </button>
            </div>

        </div>
    </form>

    <!-- PENDING DELIVERY NOTES SECTION -->
    <div class="mt-5 pt-4">
        <div class="d-flex align-items-center mb-4">
            <h3 class="fw-bold m-0" style="color: #2d3748;">Bons de livraison non traités</h3>
            <span class="badge bg-secondary ms-3 rounded-pill">@(Model.PendingDeliveryNotes?.Count() ?? 0)</span>
        </div>

        @if (Model.PendingDeliveryNotes?.Any() ?? false)
        {
            <div class="row g-4">
                @foreach (var note in Model.PendingDeliveryNotes)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="fancy-card h-100 d-flex flex-column border border-light">
                            <!-- Card Header -->
                            <div class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-bold text-primary">Ref: @note?.Devis?.Number</div>
                                    <small class="text-muted"><i class="bi bi-calendar-event me-1"></i>@note?.Date.ToString("dd/MM/yyyy")</small>
                                </div>
                                <span class="badge bg-primary text-white shadow-sm">@note?.Devis?.Client?.Name</span>
                            </div>

                            <!-- Card Body (Items) -->
                            <div class="p-2 flex-grow-1">
                                <ul class="list-group list-group-flush">
                                    @foreach (var it in note?.Items ?? new ())
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent border-0 px-0 py-1">
                                            <span class="text-truncate" style="max-width: 70%;">@it.Description</span>
                                            <span class="badge bg-light text-dark"> @it.Quantity</span>
                                        </li>
                                    }
                                </ul>
                            </div>

                            <!-- Card Footer -->
                            <div class="p-3 bg-light border-top text-end">
                                <small class="text-muted fw-bold">BL N°: @note?.Number</small>
                                <!-- You can add a button here later to "Convert to Invoice" -->
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-secondary text-center py-4 rounded-4 border-0">
                <i class="bi bi-truck fs-1 d-block mb-2 text-muted"></i>
                <span class="text-muted fw-bold">Aucun bon de livraison en attente.</span>
            </div>
        }
    </div>

</div>

<!-- Auto Download Script -->
@if (TempData["TriggerDownload"] as bool? == true)
{
    <script>
        window.onload = function() {
            setTimeout(function() {
                window.location.href = '?handler=DownloadFile';
            }, 500);
        };
    </script>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // 1. Fixed Submit Logic
        $(document).ready(function () {
            // Remove row logic for existing rows
            $(document).on('click', '.remove-row', function () {
                $(this).closest('tr').remove();
            });

            $("#invoiceForm").on("submit", function (e) {
                if ($(this).valid()) {
                    var btn = $("#btnSubmit");
                    btn.prop("disabled", true);
                    btn.html('<span class="spinner-border spinner-border-sm me-2"></span> Traitement...');
                }
            });
        });

        // 2. Add Item Logic (Matches New Design)
        function addItemRow() {
            var table = document.getElementById("itemsTable").getElementsByTagName('tbody')[0];
            var rowCount = table.rows.length;
            var row = table.insertRow(rowCount);
            var uniqueId = Date.now(); // Unique ID for Radio buttons

            row.innerHTML = `
                <td class="p-2">
                    <input name="Items[${rowCount}].Description" class="form-control bg-light border border-dark" placeholder="Description..." required />
                </td>
                <td class="p-2">
                    <input name="Items[${rowCount}].Quantity" type="number" class="form-control bg-light border border-dark" required />
                </td>
                <td class="p-2 text-center">
                    <div class="btn-group btn-group-sm" role="group">
                        <input type="radio" class="btn-check" name="Items[${rowCount}].Tva" value="true" id="tvayes_${uniqueId}" required checked>
                        <label class="btn btn-outline-primary border-dark" for="tvayes_${uniqueId}">Oui</label>

                        <input type="radio" class="btn-check" name="Items[${rowCount}].Tva" value="false" id="tvano_${uniqueId}">
                        <label class="btn btn-outline-secondary border-dark" for="tvano_${uniqueId}">Non</label>
                    </div>
                </td>
                <td class="p-2">
                    <div class="input-group">
                        <input name="Items[${rowCount}].Price" type="number" step="0.001" class="form-control bg-light border border-dark" placeholder="0.000" required />
                        <span class="input-group-text bg-light border border-dark border-start-0 text-muted">DT</span>
                    </div>
                </td>
                <td class="p-2 text-end">
                    <button type="button" class="btn btn-light text-danger border border-dark rounded-circle shadow-sm remove-row">
                        <i class="bi bi-trash-fill"></i>
                    </button>
                </td>
            `;

            // Re-enable validation for new fields
            if (window.jQuery && $.validator && $.validator.unobtrusive) {
                $.validator.unobtrusive.parse($('#invoiceForm'));
            }
        }
    </script>
}