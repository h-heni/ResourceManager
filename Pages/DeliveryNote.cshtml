@page
@model DeliveryNoteModel
@{
    ViewData["Title"] = "Create Delivery Note";
}

<div class="container py-5">

    <!-- Header -->
    <div class="text-center mb-5">
        <h1>Bon de Livraison</h1>
        <div style="height: 4px; width: 60px; background: #764ba2; margin: 10px auto; border-radius: 2px;"></div>
        <p class="text-muted">Créez un bon de livraison ou gérez les devis en attente</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success fancy-card border-start border-success border-5 mb-4 d-flex align-items-center">
            <i class="bi bi-check-circle-fill text-success fs-4 me-3"></i>
            <div>@TempData["SuccessMessage"]</div>
        </div>
    }
    @if (TempData["FailedMessage"] != null)
    {
        <div class="alert alert-danger fancy-card border-start border-danger border-5 mb-4 d-flex align-items-center">
            <i class="bi bi-x-circle-fill text-danger fs-4 me-3"></i>
            <div>@TempData["FailedMessage"]</div>
        </div>
    }

    <form method="post" id="deliveryNoteForm">
        <div class="fancy-card p-5 mb-5">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Invoice Selection Section -->
            <div class="mb-5">
                <label class="form-label text-uppercase text-muted fw-bold small ms-1">Lier à un Devis</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-0"><i class="bi bi-receipt text-primary fs-4"></i></span>
                    <!-- CHANGED: bg-light + border-dark -->
                    <select asp-for="SelectedDevisId" asp-items="Model.DevisSelectList" class="form-select form-select-lg bg-light border border-dark fw-bold text-dark">
                        <option value="">-- Sélectionner une facture --</option>
                    </select>
                </div>
                <span asp-validation-for="SelectedDevisId" class="text-danger small ms-2"></span>
            </div>

            <!-- Items Section -->
            <div class="mb-4">
                <h5 class="text-muted fw-bold text-uppercase small mb-3 border-bottom pb-2">Articles de livraison (Sans prix)</h5>

                <div class="table-responsive">
                    <table class="table table-borderless align-middle" id="itemsTable">
                        <thead class="text-secondary small text-uppercase">
                            <tr>
                                <th style="width: 60%;" class="pb-3">Description</th>
                                <th style="width: 20%;" class="text-center pb-3">Quantité</th>
                                <th style="width: 20%;" class="pb-3"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.DeliveryItems.Count; i++)
                            {
                                <tr>
                                    <td class="p-2">
                                        <input asp-for="DeliveryItems[i].Description" class="form-control bg-light border border-dark" placeholder="Description de l'article" />
                                        <span asp-validation-for="DeliveryItems[i].Description" class="text-danger small"></span>
                                    </td>
                                    <td class="p-2">
                                        <input asp-for="DeliveryItems[i].Quantity" type="number" class="form-control bg-light border border-dark text-center" placeholder="0" />
                                        <span asp-validation-for="DeliveryItems[i].Quantity" class="text-danger small"></span>
                                    </td>
                                    <td class="p-2 text-end">
                                        <button type="button" class="btn btn-light text-danger border border-dark rounded-circle shadow-sm" onclick="this.closest('tr').remove()">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="text-center mt-3">
                    <button type="button" class="btn btn-light text-primary border-dark border rounded-pill px-4 shadow-sm fw-bold" onclick="addItemRow()">
                        <i class="bi bi-plus-lg me-1"></i> Ajouter un article
                    </button>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex justify-content-end gap-3 pt-4 border-top border-dark mt-4">
                <a asp-page="./Index" class="btn btn-outline-secondary rounded-pill px-4 fw-bold border-dark text-dark">Annuler</a>
                <button type="submit" id="btnSubmit" class="btn btn-gradient rounded-pill px-5 py-2 shadow border border-dark">
                    Sauvegarder & Télécharger
                </button>
            </div>
        </div>
    </form>

    <!-- PENDING DEVIS SECTION -->
    <div class="mt-5 pt-4">
        <div class="d-flex align-items-center mb-4">
            <h3 class="fw-bold m-0" style="color: #2d3748;">Devis non traités</h3>
            <span class="badge bg-secondary ms-3 rounded-pill">@(Model.PendingDevis?.Count() ?? 0)</span>
        </div>

        @if (Model.PendingDevis?.Any() ?? false)
        {
            <div class="row g-4">
                @foreach (var devis in Model.PendingDevis)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="fancy-card h-100 d-flex flex-column border border-light">
                            <!-- Card Header -->
                            <div class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-bold text-primary">#@devis?.Number</div>
                                    <small class="text-muted"><i class="bi bi-calendar-event me-1"></i>@devis?.Date.ToString("dd/MM/yyyy")</small>
                                </div>
                                <span class="badge bg-primary text-white shadow-sm">@devis?.Client?.Name</span>
                            </div>

                            <!-- Card Body (Items) -->
                            <div class="p-3 flex-grow-1">
                                <ul class="list-group list-group-flush small">
                                    @foreach (var it in devis?.Items?? [] )
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent border-0 px-0 py-1">
                                            <span class="text-truncate" style="max-width: 70%;">@it.Description</span>
                                            <span class="text-truncate"> @it.Quantity</span>
                                        </li>
                                    }
                                    
                                </ul>
                            </div>

                            <!-- Card Footer (Delete Action) -->
                            <div class="p-3 bg-light border-top text-end">
                                <form method="post">
                                    <input type="hidden" name="id" value="@devis?.Id" />
                                    <button type="submit" asp-page-handler="Delete" formnovalidate
                                            class="btn btn-outline-danger btn-sm border-dark text-dark rounded-pill"
                                            onclick="return confirm('Voulez-vous vraiment supprimer ce devis ?');">
                                        <i class="bi bi-trash"></i> Supprimer
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-secondary text-center py-4 rounded-4 border-0">
                <i class="bi bi-inbox fs-1 d-block mb-2 text-muted"></i>
                <span class="text-muted fw-bold">Aucun devis en attente pour le moment.</span>
            </div>
        }
    </div>

</div>

@if (TempData["TriggerDownload"] as bool? == true)
{
    <script>
        window.onload = function() {
            setTimeout(function() {
                window.location.href = '?handler=DownloadFile';
            }, 500);
        };
    </script>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // 1. Smart Submit Logic (Prevents stuck gray button)
        $(document).ready(function () {
            $("#deliveryNoteForm").on("submit", function (e) {
                if ($(this).valid()) {
                    var btn = $("#btnSubmit");
                    btn.prop("disabled", true);
                    btn.html('<span class="spinner-border spinner-border-sm me-2"></span> Traitement...');
                }
            });
        });

        // 2. Add Row Logic (Updated with Fancy Classes)
        function addItemRow() {
             var table = document.getElementById("itemsTable").getElementsByTagName('tbody')[0];
             var rowCount = table.rows.length;
             var row = table.insertRow(rowCount);

             // IMPORTANT: Using bg-light and border-dark to match your style
             row.innerHTML = `
                 <td class="p-2">
                    <input name="DeliveryItems[${rowCount}].Description" class="form-control bg-light border border-dark" placeholder="Description..." />
                 </td>
                 <td class="p-2">
                    <input name="DeliveryItems[${rowCount}].Quantity" type="number" class="form-control bg-light border border-dark text-center" placeholder="0" />
                 </td>
                 <td class="p-2 text-end">
                    <button type="button" class="btn btn-light text-danger border border-dark rounded-circle shadow-sm" onclick="this.closest('tr').remove()">
                        <i class="bi bi-trash-fill"></i>
                    </button>
                 </td>
             `;

             if (window.jQuery && $.validator && $.validator.unobtrusive) {
                 $.validator.unobtrusive.parse($('#deliveryNoteForm'));
             }
         }
    </script>
}