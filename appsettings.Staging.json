{
  "Security": {
    "DisableHttps": false,
    "CookieSecure": true,
    "CookieSameSite": "Strict",
    "RequireWebhookSecrets": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "OVERRIDE_VIA_ENVIRONMENT_VARIABLE"
  },
  "Redis": {
    "ConnectionString": "OVERRIDE_VIA_ENVIRONMENT_VARIABLE",
    "InstanceName": "ResourceManager_Staging_",
    "DefaultExpirationMinutes": 30,
    "SlidingExpirationMinutes": 10
  },
  "Supabase": {
    "Url": "OVERRIDE_VIA_ENVIRONMENT_VARIABLE",
    "Key": "OVERRIDE_VIA_ENVIRONMENT_VARIABLE"
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "OVERRIDE_VIA_ENVIRONMENT_VARIABLE",
    "Issuer": "ResourceManager-Staging",
    "Audience": "ResourceManager-Staging-Users",
    "TokenExpirationInMinutes": 60
  },
  "Google": {
    "ClientId": "OVERRIDE_VIA_ENVIRONMENT_VARIABLE",
    "ClientSecret": "OVERRIDE_VIA_ENVIRONMENT_VARIABLE",
    "RefreshToken": "OVERRIDE_VIA_ENVIRONMENT_VARIABLE"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  }
}
