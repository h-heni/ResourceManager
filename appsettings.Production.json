{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Error"
    }
  },
  "Kestrel": {
    "Limits": {
      "MaxConcurrentConnections": 200,
      "MaxConcurrentUpgradedConnections": 200,
      "MaxRequestBodySize": 10485760,
      "KeepAliveTimeout": "00:02:00",
      "RequestHeadersTimeout": "00:00:30"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "OVERRIDE_VIA_ENVIRONMENT_VARIABLE"
  },
  "Redis": {
    "ConnectionString": "OVERRIDE_VIA_ENVIRONMENT_VARIABLE",
    "InstanceName": "ResourceManager_",
    "DefaultExpirationMinutes": 60,
    "SlidingExpirationMinutes": 15
  },
  "Supabase": {
    "Url": "OVERRIDE_VIA_ENVIRONMENT_VARIABLE",
    "Key": "OVERRIDE_VIA_ENVIRONMENT_VARIABLE"
  },
  "AllowedHosts": "rscmanager.com;www.rscmanager.com",
  "Security": {
    "DisableHttps": false,
    "CookieSecure": true,
    "CookieSameSite": "Strict",
    "RequireWebhookSecrets": true
  },
  "Jwt": {
    "Key": "OVERRIDE_VIA_ENVIRONMENT_VARIABLE",
    "Issuer": "ResourceManager",
    "Audience": "ResourceManager-Users",
    "TokenExpirationInMinutes": 60
  },

  "Cors": {
    "AllowedOrigins": [ "https://rscmanager.com", "https://www.rscmanager.com" ]
  },
  "App": {
    "BaseUrl": "https://rscmanager.com"
  },
  "Email": {
    "SmtpPort": 587,
    "FromName": "Resource Manager",
    "EnableSsl": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Error",
        "System": "Error"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  }
}
