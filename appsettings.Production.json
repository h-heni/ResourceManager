{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Error"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "OVERRIDE_VIA_ENVIRONMENT_VARIABLE"
  },
  "Supabase": {
    "Url": "OVERRIDE_VIA_ENVIRONMENT_VARIABLE",
    "Key": "OVERRIDE_VIA_ENVIRONMENT_VARIABLE"
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "OVERRIDE_VIA_ENVIRONMENT_VARIABLE",
    "Issuer": "ResourceManager",
    "Audience": "ResourceManager-Users",
    "TokenExpirationInMinutes": 60
  },
  "Google": {
    "ClientId": "OVERRIDE_VIA_ENVIRONMENT_VARIABLE",
    "ClientSecret": "OVERRIDE_VIA_ENVIRONMENT_VARIABLE",
    "RefreshToken": "OVERRIDE_VIA_ENVIRONMENT_VARIABLE"
  },

  "Cors": {
    "AllowedOrigins": [ "http://85.214.180.48" ]
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Error",
        "System": "Error"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  }
}
